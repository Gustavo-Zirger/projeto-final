# Docker local: localhost:8080 | Codespaces: <seu-codespace>-8080.app.github.dev
MOODLE_HOST=localhost:8080
MOODLE_PUBLIC_URL=http://localhost:8080

# Rede interna do Docker (não precisa alterar)
MOODLE_REST_URL=http://moodle-web:8080/webservice/rest/server.php

# Gerados na interface web do Moodle (Site administration -> Server -> Web services)
MOODLE_TOKEN=cole_seu_token_aqui
MOODLE_COURSE_ID=2
POLL_INTERVAL_SECONDS=30

# Mensageria e SMTP (Mailpit local)
RABBITMQ_USER=reengagement
RABBITMQ_PASSWORD=dev-only-change-me
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lembretes@example.invalid
