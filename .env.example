# Copie para .env e preencha com os dados do Moodle desta instalacao.
MOODLE_TOKEN=
MOODLE_COURSE_ID=
MOODLE_REST_URL=http://aplicacao_web:8080/webservice/rest/server.php
MOODLE_PUBLIC_URL=https://seu-moodle.example
POLL_INTERVAL_SECONDS=3600

# Credenciais locais do RabbitMQ. Troque-as fora de ambientes de demonstracao.
RABBITMQ_USER=reengagement
RABBITMQ_PASSWORD=change-this-password
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=lembretes@example.invalid
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
RETRY_DELAY_MS=30000
MAX_RETRIES=3
